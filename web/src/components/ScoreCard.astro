---
---

<div class="score-grid" id="score-grid" style="display:none;">
  <div class="score-card score-main">
    <span class="score-value" id="score-value">--</span>
    <span class="score-label">Security Score</span>
  </div>
  <div class="score-card">
    <span class="score-value text-green" id="passed-count">0</span>
    <span class="score-label">Passed</span>
  </div>
  <div class="score-card">
    <span class="score-value text-red" id="failed-count">0</span>
    <span class="score-label">Failed</span>
  </div>
  <div class="score-card">
    <span class="score-value text-muted" id="total-count">0</span>
    <span class="score-label">Total Checked</span>
  </div>
</div>

<style>
  .score-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .score-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .score-main { border-color: var(--accent); background: var(--accent-subtle); }

  .score-value {
    font-size: 1.5rem;
    font-weight: 700;
    font-family: var(--mono);
    letter-spacing: -0.02em;
  }

  .score-label {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .text-green { color: var(--green); }
  .text-red { color: var(--red); }
  .text-muted { color: var(--text-secondary); }
</style>
